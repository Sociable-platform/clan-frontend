{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clan.dev/schemas/experience-config/v1.json",
  "title": "Clan experience config v1",
  "description": "One data-only document that Studio produces, the platform stores and the SDK renders. No HTML, JS or URLs. Unknown fields are rejected everywhere. Maximum serialized size 65536 bytes (UTF-8) is enforced by the validator before parsing, because JSON Schema cannot express it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game_id", "theme", "layout", "friends", "clan", "chat", "texts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "game_id": { "$ref": "#/$defs/gameId" },
    "theme": { "$ref": "#/$defs/theme" },
    "layout": { "$ref": "#/$defs/layout" },
    "friends": { "$ref": "#/$defs/friends" },
    "clan": { "$ref": "#/$defs/clan" },
    "chat": { "$ref": "#/$defs/chat" },
    "texts": { "$ref": "#/$defs/texts" }
  },
  "anyOf": [
    { "properties": { "friends": { "type": "object", "properties": { "enabled": { "const": true } } } } },
    { "properties": { "clan": { "type": "object", "properties": { "enabled": { "const": true } } } } },
    { "properties": { "chat": { "type": "object", "properties": { "enabled": { "const": true } } } } }
  ],
  "$defs": {
    "gameId": {
      "description": "Platform Game.id (lowercase, hyphenated UUID). Replaces the legacy project id / public_key.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "customAssetId": {
      "description": "The name of a game-supplied image: a custom badge or texture. Studio makes it from the file name (custom-dragon). The config carries only this name, never the image, a URL or a path; the game developer maps it to a file of their own in the SDK `assets` option, and the SDK shows a neutral tile or no texture when the game maps nothing.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^custom-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "clanRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canPromote", "canKick"],
      "properties": {
        "id": {
          "description": "Stable machine name (member, elder, co-leader). It is what the platform stores for a player, so it does not change when the title is renamed.",
          "type": "string",
          "maxLength": 24,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "name": {
          "description": "The title players see (Member, Elder, Co-leader). 1-20 characters, same text rules as labels.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[^<>]+$",
          "not": { "pattern": "(https?:|www\\.|//)" }
        },
        "canPromote": { "type": "boolean" },
        "canKick": { "type": "boolean" },
        "canHandleRequests": {
          "description": "May accept and decline the requests to join a closed clan. Optional: a role without it has the power when it has canKick. The owner always has it.",
          "type": "boolean"
        }
      }
    },
    "partStyle": {
      "description": "The look of one part of the widget. bubbleMine and bubbleTheirs: chat bubbles (your messages, other players'). button: the main buttons and the launcher. buttonSecondary: outlined and dashed buttons (Cancel, View members, Leave). tab and tabSelected: the tab bar. row: list rows and cards (clans, members, requests, the clan header). Every field is optional; text is the color of the text on the part.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/hexColor" },
        "text": { "$ref": "#/$defs/hexColor" },
        "borderStyle": { "enum": ["none", "solid", "double", "bevel", "inset"] },
        "borderWidth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "borderColor": { "$ref": "#/$defs/hexColor" },
        "radius": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "hexColor": {
      "description": "Canonical form: # plus six UPPERCASE hex digits. Studio normalizes before saving.",
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "source"],
      "properties": {
        "family": {
          "description": "Curated Google Fonts list (the Studio font picker). Free-form family names are rejected so no config can make the SDK load an arbitrary resource.",
          "enum": [
            "Inter", "Roboto", "Open Sans", "Lato", "Montserrat", "Poppins",
            "Nunito", "Rubik", "Space Grotesk", "Kanit", "Titillium Web", "Quicksand",
            "Unbounded", "Oswald", "Bebas Neue", "Anton", "Teko", "Righteous", "Bungee",
            "Orbitron", "Exo 2", "Rajdhani", "Audiowide", "Chakra Petch", "Saira",
            "Russo One", "Black Ops One",
            "Press Start 2P", "VT323", "Silkscreen", "Pixelify Sans",
            "Cinzel", "MedievalSharp", "Uncial Antiqua", "Pirata One", "Metamorphous",
            "Fredoka", "Baloo 2", "Luckiest Guy", "Bangers", "Comfortaa",
            "JetBrains Mono", "Share Tech Mono"
          ]
        },
        "source": { "const": "google" }
      }
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "fit", "strength"],
      "properties": {
        "asset": {
          "description": "A texture built into the SDK, or the name of an image the game developer imported in Studio (custom-...). Never a URL: the game maps a custom name to its own file.",
          "anyOf": [
            { "enum": ["tex_stone", "tex_grid", "tex_wood", "tex_carbon"] },
            { "$ref": "#/$defs/customAssetId" }
          ]
        },
        "fit": { "const": "tile" },
        "strength": { "const": "subtle" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fonts", "frame", "buttons", "panel", "colors", "textures"],
      "properties": {
        "mode": { "enum": ["dark", "light"] },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading", "body"],
          "properties": {
            "heading": { "$ref": "#/$defs/font" },
            "body": { "$ref": "#/$defs/font" }
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "width", "color", "corners"],
          "properties": {
            "style": { "enum": ["none", "solid", "double", "bevel", "inset"] },
            "width": { "type": "integer", "minimum": 1, "maximum": 8 },
            "color": { "$ref": "#/$defs/hexColor" },
            "corners": { "enum": ["square", "soft", "round", "chamfer"] }
          }
        },
        "buttons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "case"],
          "properties": {
            "style": { "enum": ["filled", "outline", "bevel"] },
            "case": { "enum": ["normal", "upper"] }
          }
        },
        "panel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opacity", "blur"],
          "properties": {
            "opacity": { "type": "number", "minimum": 0.5, "maximum": 1 },
            "blur": { "type": "boolean" }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brand", "background", "surface", "text", "muted"],
          "properties": {
            "brand": { "$ref": "#/$defs/hexColor" },
            "background": { "$ref": "#/$defs/hexColor" },
            "surface": { "$ref": "#/$defs/hexColor" },
            "text": { "$ref": "#/$defs/hexColor" },
            "muted": { "$ref": "#/$defs/hexColor" }
          }
        },
        "components": {
          "description": "Optional per-part overrides on top of the theme: a part with no entry (or a field left out) keeps the look the rest of the theme gives it. Studio writes an entry only when the developer customizes that part.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bubbleMine": { "$ref": "#/$defs/partStyle" },
            "bubbleTheirs": { "$ref": "#/$defs/partStyle" },
            "button": { "$ref": "#/$defs/partStyle" },
            "buttonSecondary": { "$ref": "#/$defs/partStyle" },
            "tab": { "$ref": "#/$defs/partStyle" },
            "tabSelected": { "$ref": "#/$defs/partStyle" },
            "row": { "$ref": "#/$defs/partStyle" }
          }
        },
        "textures": {
          "description": "Optional per-slot textures; a missing slot means no texture.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "panel": { "$ref": "#/$defs/texture" },
            "content": { "$ref": "#/$defs/texture" },
            "button": { "$ref": "#/$defs/texture" },
            "bubble": { "$ref": "#/$defs/texture" }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "startCollapsed"],
      "properties": {
        "position": { "enum": ["bottom-left", "bottom-right"] },
        "startCollapsed": { "type": "boolean" }
      }
    },
    "friends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "clan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxMembers", "descriptionMax", "roles", "badges", "screens"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxMembers": { "type": "integer", "minimum": 2, "maximum": 200 },
        "descriptionMax": { "type": "integer", "minimum": 20, "maximum": 300 },
        "roles": {
          "description": "The titles a clan member can hold, lowest power first: the first role is what a new member gets, the last is the clan owner's (exactly one holder, the creator). Power is the position in this list: a member can promote, demote or kick only someone of a lower role, and can promote only up to the role just below their own. `canPromote` and `canKick` switch those powers on per role (the last role always has both). `canHandleRequests` lets a role, the first included, accept and decline requests to join a closed clan; without it a role has that power when it has `canKick`. Role ids must be unique, which the schema cannot express: the validator checks it.",
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/clanRole" }
        },
        "badges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "allowed"],
          "properties": {
            "source": { "const": "developer" },
            "allowed": {
              "description": "Badge icons players can pick from: icons built into the SDK, or names of images the game developer imported in Studio (custom-...) and maps to its own files. An empty list falls back to a neutral tag.",
              "type": "array",
              "uniqueItems": true,
              "maxItems": 12,
              "items": {
                "anyOf": [
                  { "enum": ["star", "diamond", "peak", "spark", "moon", "cross"] },
                  { "$ref": "#/$defs/customAssetId" }
                ]
              }
            }
          }
        },
        "screens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discover", "create", "home", "members"],
          "properties": {
            "discover": { "$ref": "#/$defs/simpleScreen" },
            "create": { "$ref": "#/$defs/simpleScreen" },
            "home": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "header", "showStats"],
              "properties": {
                "enabled": { "type": "boolean" },
                "header": { "const": "compact" },
                "showStats": { "type": "boolean" }
              }
            },
            "members": { "$ref": "#/$defs/simpleScreen" }
          }
        }
      }
    },
    "simpleScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "layout", "directMessages", "clanChat",
        "maxMessageLength", "slowModeSeconds", "profanityFilter", "historyLimit"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "layout": { "enum": ["bubbles", "log"] },
        "directMessages": { "type": "boolean" },
        "clanChat": { "type": "boolean" },
        "maxMessageLength": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "slowModeSeconds": { "type": "integer", "minimum": 0, "maximum": 30 },
        "profanityFilter": { "type": "boolean" },
        "historyLimit": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "text": {
      "description": "Plain text only: no angle brackets, no URLs. Placeholders {Clan}, {clan}, {Clans}, {clans} are allowed and resolved by the SDK. Written without lookahead so the same pattern runs in Go (RE2) and JS.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^<>]+$",
      "not": { "pattern": "(https?:|www\\.|//)" }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "labels"],
      "properties": {
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clan", "clans"],
          "properties": {
            "clan": { "$ref": "#/$defs/term" },
            "clans": { "$ref": "#/$defs/term" }
          }
        },
        "labels": {
          "description": "Overrides only; a missing key uses the SDK default.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "panelTitle": { "$ref": "#/$defs/text" },
            "launcher": { "$ref": "#/$defs/text" },
            "tabFriends": { "$ref": "#/$defs/text" },
            "tabClan": { "$ref": "#/$defs/text" },
            "tabChat": { "$ref": "#/$defs/text" },
            "accept": { "$ref": "#/$defs/text" },
            "chatBtn": { "$ref": "#/$defs/text" },
            "join": { "$ref": "#/$defs/text" },
            "full": { "$ref": "#/$defs/text" },
            "createCta": { "$ref": "#/$defs/text" },
            "createBtn": { "$ref": "#/$defs/text" },
            "cancel": { "$ref": "#/$defs/text" },
            "info": { "$ref": "#/$defs/text" },
            "viewMembers": { "$ref": "#/$defs/text" },
            "leave": { "$ref": "#/$defs/text" },
            "send": { "$ref": "#/$defs/text" },
            "createTitle": { "$ref": "#/$defs/text" },
            "membersTitle": { "$ref": "#/$defs/text" },
            "searchPlayers": { "$ref": "#/$defs/text" },
            "searchClans": { "$ref": "#/$defs/text" },
            "messagePh": { "$ref": "#/$defs/text" },
            "clanChatOff": { "$ref": "#/$defs/text" },
            "memberJoined": { "$ref": "#/$defs/text" },
            "memberLeft": { "$ref": "#/$defs/text" },
            "memberKicked": { "$ref": "#/$defs/text" },
            "memberKickedBy": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "term": {
      "description": "The player-facing word for a clan (e.g. Guild). Max 20 characters, same text rules as labels.",
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[^<>]+$",
      "not": { "pattern": "(https?:|www\\.|//)" }
    }
  }
}
