# Base URL of the Platform API (clan-backend, openapi/platform.yaml).
# Local default: the Go service on :8081, which allows CORS from http://localhost:5173.
VITE_PLATFORM_URL=http://localhost:8081
# Optional. The support address, shown on the Support page and in the banner a suspended developer
# sees. Without it the team's address is used (sociableplatform.support@gmail.com).
# VITE_SUPPORT_EMAIL=support@example.com
# Optional: an outside address for the documentation. Without it the Docs links open the guide
# built into Studio (/docs).
# VITE_DOCS_URL=https://example.com/docs
# Optional: the addresses the guide shows in its code samples. Without them they follow
# VITE_PLATFORM_URL (platform.<host> gives sdk.<host>, social.<host>, realtime.<host>; a local
# address gives the docker compose ports).
# VITE_SDK_URL=https://sdk.example.com
# VITE_SOCIAL_URL=https://social.example.com
# VITE_REALTIME_URL=https://realtime.example.com
